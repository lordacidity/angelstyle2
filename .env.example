# =============================================================================
# angelstyle2 — example env file. Copy to `.env` (repo root) and fill in real
# values. `.env` is gitignored; THIS file is the committed template.
#   cp .env.example .env
# Loaded by frontend/next.config.ts (via process.loadEnvFile) AND the Express
# server (server/src/index.ts points dotenv at this file).
# =============================================================================

# --- Pauv Supabase MAIN (READ-ONLY: talents, NPSI, markets) ---
# Public anon key (safe in the client) + project URL from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-main-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-main-anon-key

# --- Supabase Distribution (auth — Studio sign-in / brand kit) ---
NEXT_PUBLIC_SUPABASE_DIST_URL=https://your-distribution-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# --- Railway Postgres (markets history, NPSI batch) ---
# Paste the connection string from Railway's Connect panel.
DATABASE_PUBLIC_URL=postgresql://postgres:password@host.proxy.rlwy.net:PORT/railway
PGUSER=postgres
PGPASSWORD=your-postgres-password
PGHOST=host.proxy.rlwy.net
PGPORT=5432
PGDATABASE=railway

# --- External APIs (server-only secrets) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
NEWSDATA_API_KEY=pub_your-newsdata-key
SERPAPI_KEY=your-serpapi-key
TWITTERAPI_IO_KEY=your-twitterapi-io-key

# --- Google Gemini — auto-context: watches the linked video + reads its caption,
#     drafts the 2-sentence context fed to the social-caption generator. ---
GEMINI_API_KEY=your-gemini-api-key
# Optional model override. deepseek-chat is retired; the DeepSeek client defaults
# to deepseek-v4-flash (set DEEPSEEK_MODEL to deepseek-v4-pro for higher quality).
GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- Optional ---
# SUPABASE_SECRET_KEY=          # Service-role key; falls back to anon if unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# NEXT_PUBLIC_PHONEDECK_URL=http://localhost:8080
# PHONEDECK_URL=http://localhost:8080

# --- Supabase VIDS (dedicated project — ONLY the Vids library's file storage) ---
# Server-only. Video rows live in Railway Postgres (DATABASE_PUBLIC_URL) like the
# board; this project just holds the files in its public `vids` bucket, which is
# created automatically. Uploads go browser → bucket via signed URLs from
# /api/vids/videos/sign, so neither key ever reaches the client.
# VIDS_SUPABASE_URL=https://your-vids-project.supabase.co
# VIDS_SUPABASE_SECRET_KEY=sb_secret_your-key

# --- Pauv AI Pricer (Studio > Pricer) ---
# Claude runs the social step (Haiku 4.5 + web search) and the judge (Opus 5); Gemini the rest.
# About $0.22 per pricing. Peer lines + the pricing log live in Railway Postgres (DATABASE_PUBLIC_URL above).
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# The pricer's Gemini research model. Deliberately NOT the site's GEMINI_MODEL above (the caption model):
# the pricer was calibrated on gemini-3.8-flash, which is the default when this is unset.
# PRICER_GEMINI_MODEL=gemini-3.8-flash
# Optional overrides, defaults shown. JUDGE_EFFORT: low | medium | high | xhigh | max. JUDGE_CACHE_TTL: 5m or 1h.
# JUDGE_MODEL=claude-opus-5
# JUDGE_EFFORT=medium
# JUDGE_CACHE_TTL=1h
# SOCIAL_MODEL=claude-haiku-4-5
# Set to also show the final price in credits.
# PAUV_CREDITS_PER_USD=
# NEWS_WINDOW_DAYS=90
# Streamers/gamers/online celebrities are priced this much below the judge's number; 0 disables.
# ONLINE_CELEB_DISCOUNT=0.25
