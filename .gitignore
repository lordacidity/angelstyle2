# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/

# Runtime data — phone names, account usernames, themes, file history, settings.
# These are personal/instance-specific and should never be in source control.
server/data/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log
npm-debug.log*

# Local environment overrides
.env
.env.local

# Claude Code local (personal) settings
.claude/settings.local.json

# Misc
*.tsbuildinfo

# Local device tooling — scrcpy/adb binaries downloaded by setup.ps1 at install
# time (~55MB). Regenerated per machine; never committed.
tools/
