{
  "name": "ai-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Localhost tool to insert yourself (Aiden) into YouTube videos via Kling Elements + Gemini.",
  "scripts": {
    "dev": "node --watch-path=./server server/index.js",
    "start": "node server/index.js",
    "setup": "npm install && npm --prefix client install",
    "build:client": "npm --prefix client run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.1.1",
    "youtube-dl-exec": "^3.0.12"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  }
}
